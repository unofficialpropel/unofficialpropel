{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Zensical Serve",
			"type": "shell",
			"command": "uv run zensical serve",
			"group": "none",
			"isBackground": true,
			"presentation": {
				"reveal": "silent",
				"panel": "new"
			},
			"problemMatcher": [
				{
					"base": "$tsc",
					"background": {
						"activeOnStart": true,
						"beginsPattern": "Build started",
						"endsPattern": "(No issues found|issues? found|Build finished)"
					}
				}
			]
		}
	]
}
